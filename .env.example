# FraudGuard environment configuration template.
# Copy this file to .env and adjust values for your machine.
#   PowerShell:  Copy-Item .env.example .env
# Never commit the real .env file; it is excluded by .gitignore.

# --- Application -----------------------------------------------------------
APP_NAME=FraudGuard
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (Neon PostgreSQL) --------------------------------------------
# Leave EMPTY to run without persistence: /predict still scores transactions and
# simply skips storing alerts (a warning is logged).
#
# Use the POOLED connection string from the Neon dashboard - its host contains
# "-pooler". Serverless functions open many short-lived connections, and the
# pooler multiplexes them onto a few real Postgres backends so the instance
# connection limit is not exhausted.
#
#   * postgresql+psycopg:// selects SQLAlchemy's psycopg 3 driver.
#   * sslmode=require is mandatory for Neon.
#   * The password is inside the URL: never commit or log a real value.
DATABASE_URL=
# Example (replace every placeholder with your own Neon values):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-cool-name-123456-pooler.eu-central-1.aws.neon.tech/fraudguard?sslmode=require

# Seconds to wait for a TCP connection to the database (keep short on serverless).
DB_CONNECT_TIMEOUT=10
# Log every SQL statement (very noisy - development only).
DB_ECHO=false

# --- CORS (browser dashboard) ----------------------------------------------
# Comma-separated list of origins allowed to call this API from a browser.
# Explicit origins only - never a wildcard. Defaults to the Vite dev server, which
# is what "npm run dev" in frontend/ serves. The Docker Compose stack serves the
# dashboard from http://localhost:8080 and sets its own value, so 8080 is only
# needed here if you run the containers with a different published port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Model artifacts -------------------------------------------------------
# Deployed model: the trained XGBoost Booster in native UBJ format, exported by
# scripts/export_native_model.py (model + decision threshold + feature order +
# training metadata inside the file). The original Joblib bundle is kept only as
# a development fallback and is not needed to serve the API.
MODEL_PATH=artifacts/models/fraud_model.ubj
