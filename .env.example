# FraudGuard environment configuration template.
# Copy this file to .env and adjust values for your machine.
#   PowerShell:  Copy-Item .env.example .env
# Never commit the real .env file; it is excluded by .gitignore.

# --- Application -----------------------------------------------------------
APP_NAME=FraudGuard
APP_ENV=development
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Phase 1 does not open a database connection. This is a placeholder for
# later phases. psycopg 3 connection string format (postgresql+psycopg://).
DATABASE_URL=postgresql+psycopg://fraudguard:change_me@localhost:5432/fraudguard

# --- Model artifacts -------------------------------------------------------
# Where a trained model would be stored in a later phase.
MODEL_PATH=artifacts/fraud_model.joblib
