# Frontend environment configuration template.
# Copy to .env.local (git-ignored) and adjust if the API is not on the default port.
#
# Only public configuration belongs here. Never put database credentials, API
# secrets, or any private key in a VITE_ variable: Vite inlines these values into
# the JavaScript bundle that every visitor downloads.
VITE_API_BASE_URL=http://127.0.0.1:8000
